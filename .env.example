# Django
DJANGO_SECRET_KEY=change-me-in-production-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL (використовується в docker-compose.yml та settings.py)
POSTGRES_DB=locations_db
POSTGRES_USER=locations_user
POSTGRES_PASSWORD=locations_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Email (за замовчуванням console backend для зручної локальної перевірки)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@locations-map.local